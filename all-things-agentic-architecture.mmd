flowchart LR
    U[Professional request] --> API[FastAPI service\non Cloud Run]
    API --> R[Asynchronous\nBriefRunner workflow]
    R --> SDK[Google Gen AI SDK\nagent framework]
    SDK --> V[Gemini 3.5 Flash\nthrough Vertex AI]
    V --> B[Structured\nreviewable brief]
    B --> S[(Demo run-state\nSQLite store)]
    S --> STATUS[Run-status API]
    STATUS --> H[Explicit human\napproval checkpoint]
    H --> HANDOFF[Approved handoff\n`sent: false`]
    HANDOFF -. no automatic send .-> FUTURE[Optional future\nnotification connector]
    API --> LOG[Cloud Logging\noperational evidence]
    R --> LOG
    SDK --> LOG

    classDef google fill:#e8f0fe,stroke:#1a73e8,color:#174ea6,stroke-width:2px;
    classDef safety fill:#e6f4ea,stroke:#137333,color:#0d652d,stroke-width:2px;
    classDef data fill:#fef7e0,stroke:#b06000,color:#7a3900,stroke-width:2px;
    class API,R,SDK,V,LOG google;
    class H,HANDOFF safety;
    class S data;
