# Local review mode: omit these values and BriefRunner runs deterministically offline.
# Do not commit a real .env file or service-account key.

# Production Google-native mode (Vertex AI using Application Default Credentials)
AUTOMATOM_AGENT_MODE=gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# Alternative local-only Gemini Developer API mode. Use instead of Vertex settings;
# never deploy this key in a public Cloud Run service or commit it to source control.
# GEMINI_API_KEY=
